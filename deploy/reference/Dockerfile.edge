# syntax=docker/dockerfile:1.7

ARG NODE_BUILD_IMAGE
ARG NGINX_RUNTIME_IMAGE

FROM ${NODE_BUILD_IMAGE} AS ui-build
ARG NODE_BUILD_IMAGE
ARG NGINX_RUNTIME_IMAGE
ARG PNPM_VERSION
RUN node -e 'const p=/^[^@\s]+@sha256:[0-9a-f]{64}$/; for (const n of ["NODE_BUILD_IMAGE", "NGINX_RUNTIME_IMAGE"]) if (!p.test(process.env[n] || "")) process.exit(1)' && \
    test -n "${PNPM_VERSION}" && test "$(pnpm --version)" = "${PNPM_VERSION}"

WORKDIR /workspace/ui/reference
COPY ui/reference/package.json ui/reference/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/pnpm/store,sharing=locked \
    pnpm config set store-dir /pnpm/store && \
    pnpm fetch --frozen-lockfile

COPY ui/reference/ ./
RUN --mount=type=cache,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --offline --ignore-scripts && \
    pnpm build

FROM ${NGINX_RUNTIME_IMAGE} AS runtime
RUN apk add --no-cache --upgrade libcrypto3=3.5.8-r0 libssl3=3.5.8-r0
COPY --from=ui-build --chown=10001:10001 /workspace/ui/reference/dist/ /srv/dirizhor-ui/
COPY --chown=10001:10001 deploy/reference/nginx/ /opt/dirizhor/nginx/
COPY --chown=10001:10001 --chmod=0555 deploy/reference/container/edge-entrypoint.sh /usr/local/bin/dirizhor-edge

USER 10001:10001
EXPOSE 8443
STOPSIGNAL SIGQUIT
ENTRYPOINT ["/usr/local/bin/dirizhor-edge"]
