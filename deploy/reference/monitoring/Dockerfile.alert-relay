# syntax=docker/dockerfile:1.7

ARG NODE_RUNTIME_IMAGE

FROM ${NODE_RUNTIME_IMAGE} AS build
ARG NODE_RUNTIME_IMAGE
RUN node -e 'const p=/^[^@\s]+@sha256:[0-9a-f]{64}$/; if (!p.test(process.env.NODE_RUNTIME_IMAGE || "")) process.exit(1)'

FROM ${NODE_RUNTIME_IMAGE} AS runtime
ARG NODE_RUNTIME_IMAGE
ENV NODE_ENV=production
RUN node -e 'const p=/^[^@\s]+@sha256:[0-9a-f]{64}$/; if (!p.test(process.env.NODE_RUNTIME_IMAGE || "")) process.exit(1)' && \
    apk add --no-cache --upgrade libcrypto3=3.5.8-r0 libssl3=3.5.8-r0 && \
    rm -rf /usr/local/lib/node_modules/npm && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx && \
    test ! -e /usr/local/lib/node_modules/npm && \
    test ! -L /usr/local/bin/npm && \
    test ! -L /usr/local/bin/npx && \
    node --version >/dev/null

WORKDIR /app/alert-relay
COPY --chown=10001:10001 deploy/reference/monitoring/resend-relay.mjs ./resend-relay.mjs

USER 10001:10001
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["node", "resend-relay.mjs"]
