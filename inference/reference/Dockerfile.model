# syntax=docker/dockerfile:1.7

ARG LLAMA_SERVER_IMAGE
ARG MODEL_PREP_IMAGE

FROM ${MODEL_PREP_IMAGE} AS prepare

ARG MODEL_URL
ADD --checksum=sha256:7485fe6f11af29433bc51cab58009521f205840f5b4ae3a32fa7f92e8534fdf5 \
    ${MODEL_URL} /tmp/Qwen3-4B-Q4_K_M.gguf
RUN mkdir -p /model-parts && chmod 0755 /model-parts && \
    split -b 125000000 -a 2 /tmp/Qwen3-4B-Q4_K_M.gguf /model-parts/part- && \
    test "$(find /model-parts -type f | wc -l | tr -d ' ')" = 20

FROM ${LLAMA_SERVER_IMAGE}
COPY --from=prepare --chown=10001:10001 /model-parts/part-aa /model-parts/part-aa
COPY --from=prepare --chown=10001:10001 /model-parts/part-ab /model-parts/part-ab
COPY --from=prepare --chown=10001:10001 /model-parts/part-ac /model-parts/part-ac
COPY --from=prepare --chown=10001:10001 /model-parts/part-ad /model-parts/part-ad
COPY --from=prepare --chown=10001:10001 /model-parts/part-ae /model-parts/part-ae
COPY --from=prepare --chown=10001:10001 /model-parts/part-af /model-parts/part-af
COPY --from=prepare --chown=10001:10001 /model-parts/part-ag /model-parts/part-ag
COPY --from=prepare --chown=10001:10001 /model-parts/part-ah /model-parts/part-ah
COPY --from=prepare --chown=10001:10001 /model-parts/part-ai /model-parts/part-ai
COPY --from=prepare --chown=10001:10001 /model-parts/part-aj /model-parts/part-aj
COPY --from=prepare --chown=10001:10001 /model-parts/part-ak /model-parts/part-ak
COPY --from=prepare --chown=10001:10001 /model-parts/part-al /model-parts/part-al
COPY --from=prepare --chown=10001:10001 /model-parts/part-am /model-parts/part-am
COPY --from=prepare --chown=10001:10001 /model-parts/part-an /model-parts/part-an
COPY --from=prepare --chown=10001:10001 /model-parts/part-ao /model-parts/part-ao
COPY --from=prepare --chown=10001:10001 /model-parts/part-ap /model-parts/part-ap
COPY --from=prepare --chown=10001:10001 /model-parts/part-aq /model-parts/part-aq
COPY --from=prepare --chown=10001:10001 /model-parts/part-ar /model-parts/part-ar
COPY --from=prepare --chown=10001:10001 /model-parts/part-as /model-parts/part-as
COPY --from=prepare --chown=10001:10001 /model-parts/part-at /model-parts/part-at

USER 10001:10001
ENTRYPOINT ["/app/llama-server"]
